# AgathaWhisper — config por env (todas com default sensato; sem rebuild pra trocar)

# Modelo faster-whisper: tiny | base | small | medium | large-v3 | large-v3-turbo
# 'small' = melhor equilibrio pt-BR em CPU; large-v3-turbo = mais preciso e pesado.
WHISPER_MODEL=small

# device: cpu | cuda
WHISPER_DEVICE=cpu

# compute_type: int8 (CPU, rapido/leve) | float16 (GPU) | int8_float16
WHISPER_COMPUTE_TYPE=int8

# idioma fixo (evita autodeteccao errada em audio curto). Vazio = autodetecta.
WHISPER_LANGUAGE=pt

# teto do upload em MB
MAX_UPLOAD_MB=25

# nivel de log
LOG_LEVEL=INFO
